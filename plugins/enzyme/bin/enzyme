#!/bin/sh
# Enzyme wrapper — resolves the bundled platform binary.
set -e

# Resolve through symlinks to find the real plugin root.
SCRIPT="$0"
# Follow symlinks (POSIX-portable loop).
while [ -L "$SCRIPT" ]; do
    link=$(ls -ld "$SCRIPT" | sed 's/.*-> //')
    case "$link" in
        /*) SCRIPT="$link" ;;
        *)  SCRIPT="$(dirname "$SCRIPT")/$link" ;;
    esac
done
BIN_DIR=$(cd "$(dirname "$SCRIPT")" && pwd)
PLUGIN_ROOT=$(cd "$BIN_DIR/.." && pwd)

# Detect platform.
OS=$(uname -s)
ARCH=$(uname -m)

case "${OS}-${ARCH}" in
    Linux-x86_64)   BINARY="enzyme-linux-x86_64" ;;
    Linux-aarch64)  BINARY="enzyme-linux-arm64"  ;;
    *)
        echo "enzyme: this plugin bundles Linux binaries for the Claude desktop VM only." >&2
        echo "For host CLI use, install via Homebrew or https://enzyme.garden/install.sh" >&2
        echo "Standalone binaries: https://github.com/jshph/enzyme/releases" >&2
        exit 1
        ;;
esac

ENZYME_BIN="${BIN_DIR}/${BINARY}"
if [ ! -x "$ENZYME_BIN" ]; then
    echo "enzyme: bundled binary not found: ${ENZYME_BIN}" >&2
    echo "Install a standalone binary from https://github.com/jshph/enzyme/releases" >&2
    exit 1
fi

exec "$ENZYME_BIN" "$@"
