// Apple Notes preset. `apple-notes` is a built-in source kind: it reads
// ~/Library/Group Containers/group.com.apple.notes/NoteStore.sqlite with the
// query and content filter shipped in Enzyme. Add `database "…"` inside the
// braces to read another copy of the store.
workspace __WORKSPACE__ {
  source apple-notes "notes" {}

  learn questions from source "notes"
}
