#!/usr/bin/env python3
"""Run Enzyme builds in durable shared or lifecycle-owned disposable lanes."""

from __future__ import annotations

import fcntl
import json
import os
from pathlib import Path
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import uuid


SCCACHE_MODE_ENV = "ENZYME_RUST_SCCACHE"
ISOLATED_SLOT_COUNT = 2
MIN_ISOLATED_FREE_BYTES = 20 * 1024**3
TARGET_SIZE_CACHE_MAX_AGE_SECONDS = 60
STATS_MAX_LINES = 200


USAGE = """usage:
  scripts/cargo-lane status
  scripts/cargo-lane target-dir
  scripts/cargo-lane cargo-config
  scripts/cargo-lane prune
  scripts/cargo-lane sccache-stats
  scripts/cargo-lane shared -- <command> [args...]
  scripts/cargo-lane isolated -- <command> [args...]
  scripts/cargo-lane disposable -- <command> [args...]
"""


def fail(message: str, code: int = 2) -> "None":
    print(f"cargo-lane: {message}", file=sys.stderr)
    raise SystemExit(code)


def git_common_dir() -> Path:
    try:
        output = subprocess.check_output(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            text=True,
            stderr=subprocess.STDOUT,
        ).strip()
    except (OSError, subprocess.CalledProcessError) as exc:
        fail(f"could not resolve Git common directory: {exc}")
    return Path(output).resolve()


def paths() -> tuple[Path, Path, Path, Path]:
    common_dir = git_common_dir()
    repo_root = common_dir.parent
    storage_root = repo_root.parent
    target_dir = storage_root / "enzyme-rust-cargo-target"
    lock_path = storage_root / ".enzyme-rust-cargo-build.lock"
    owner_path = storage_root / ".enzyme-rust-cargo-build-owner.json"
    isolated_state_dir = storage_root / ".enzyme-rust-cargo-isolated"
    return target_dir, lock_path, owner_path, isolated_state_dir


def sccache_mode() -> str:
    mode = os.environ.get(SCCACHE_MODE_ENV, "auto").strip().lower()
    if mode not in {"auto", "off", "required"}:
        fail(f"{SCCACHE_MODE_ENV} must be auto, off, or required; got {mode!r}")
    return mode


def sccache_decision() -> dict[str, str | bool | None]:
    mode = sccache_mode()
    explicit_wrapper = os.environ.get("RUSTC_WRAPPER")
    available = shutil.which("sccache")
    if explicit_wrapper:
        if mode == "required":
            fail(
                f"{SCCACHE_MODE_ENV}=required cannot enable sccache because "
                f"RUSTC_WRAPPER is already set to {explicit_wrapper!r}"
            )
        return {
            "mode": mode,
            "available": bool(available),
            "path": available,
            "use": False,
            "reason": f"RUSTC_WRAPPER is already set to {explicit_wrapper}",
        }
    if mode == "off":
        return {
            "mode": mode,
            "available": bool(available),
            "path": available,
            "use": False,
            "reason": f"{SCCACHE_MODE_ENV}=off",
        }
    if available:
        return {
            "mode": mode,
            "available": True,
            "path": available,
            "use": True,
            "reason": "available on PATH",
        }
    if mode == "required":
        fail(f"{SCCACHE_MODE_ENV}=required but sccache was not found on PATH")
    return {
        "mode": mode,
        "available": False,
        "path": None,
        "use": False,
        "reason": "sccache not found on PATH; auto mode is a no-op",
    }


def apply_sccache(env: dict[str, str]) -> None:
    decision = sccache_decision()
    if decision["use"]:
        env["RUSTC_WRAPPER"] = str(decision["path"])


def print_sccache_status() -> None:
    decision = sccache_decision()
    availability = "yes"
    if not decision["available"]:
        availability = "no"
    path = decision["path"]
    available_detail = f" ({path})" if path else ""
    use_detail = f" ({decision['path']})" if decision["use"] else f" ({decision['reason']})"
    print(f"cargo-lane: sccache mode {decision['mode']}")
    print(f"cargo-lane: sccache available {availability}{available_detail}")
    print(f"cargo-lane: sccache use {'yes' if decision['use'] else 'no'}{use_detail}")
    print("cargo-lane: sccache stats command scripts/cargo-lane sccache-stats")


def sccache_stats() -> int:
    decision = sccache_decision()
    sccache_path = decision["path"]
    if not sccache_path:
        print(f"cargo-lane: sccache unavailable ({decision['reason']})")
        return 0
    try:
        proc = subprocess.run(
            [str(sccache_path), "--show-stats"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as exc:
        fail(f"could not run sccache --show-stats: {exc}", 127)
    lines = proc.stdout.splitlines()
    for line in lines[:STATS_MAX_LINES]:
        print(line)
    if len(lines) > STATS_MAX_LINES:
        print(f"cargo-lane: truncated sccache stats after {STATS_MAX_LINES} lines")
    if proc.stderr:
        print(proc.stderr, file=sys.stderr, end="")
    return proc.returncode


def cargo_config_text(target_dir: Path) -> str:
    decision = sccache_decision()
    lines = [
        "# Generated by enzyme-rust .bb-env-setup.sh for managed bb worktrees.",
        "# The target path is derived from Git's common directory on this host.",
        "# enzyme-rust-bb-cargo-config-v1",
        "[build]",
        f"target-dir = {json.dumps(str(target_dir))}",
    ]
    if decision["use"]:
        lines.append(f"rustc-wrapper = {json.dumps(str(decision['path']))}")
    elif decision["reason"]:
        lines.append(f"# rustc-wrapper not set: {decision['reason']}")
    return "\n".join(lines) + "\n"


def owner_summary(owner_path: Path) -> str:
    try:
        owner = json.loads(owner_path.read_text())
    except (OSError, ValueError):
        return "an unreported same-host build"
    bits = [
        f"thread={owner.get('thread_id') or 'unknown'}",
        f"pid={owner.get('pid') or 'unknown'}",
        f"host={owner.get('host') or 'unknown'}",
    ]
    command = owner.get("command")
    if command:
        bits.append(f"command={command}")
    return ", ".join(bits)


def write_json_atomic(path: Path, value: dict[str, object]) -> None:
    temporary = path.with_name(f"{path.name}.{os.getpid()}.tmp")
    temporary.write_text(json.dumps(value, indent=2) + "\n")
    os.replace(temporary, path)


def scratch_slot_paths(state_dir: Path, slot: int) -> tuple[Path, Path, Path]:
    return (
        state_dir / f"slot-{slot}.lock",
        state_dir / f"slot-{slot}-owner.json",
        state_dir / f"slot-{slot}-target",
    )


def remove_scratch_target(state_dir: Path, slot: int, target_dir: Path) -> bool:
    expected = state_dir / f"slot-{slot}-target"
    if target_dir.resolve() != expected.resolve():
        fail(f"refusing to remove unexpected scratch target {target_dir}")
    existed = target_dir.exists()
    if existed:
        shutil.rmtree(target_dir)
    return existed


def recover_scratch_slots(state_dir: Path, *, announce: bool) -> int:
    state_dir.mkdir(parents=True, exist_ok=True)
    recovered = 0
    for slot in range(1, ISOLATED_SLOT_COUNT + 1):
        lock_path, owner_path, target_dir = scratch_slot_paths(state_dir, slot)
        with lock_path.open("a+") as lock_file:
            try:
                fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                continue
            if remove_scratch_target(state_dir, slot, target_dir):
                recovered += 1
                if announce:
                    print(f"cargo-lane: recovered abandoned scratch target {target_dir}")
            owner_path.unlink(missing_ok=True)
    return recovered


def isolated_status(state_dir: Path) -> int:
    state_dir.mkdir(parents=True, exist_ok=True)
    busy = 0
    for slot in range(1, ISOLATED_SLOT_COUNT + 1):
        lock_path, owner_path, target_dir = scratch_slot_paths(state_dir, slot)
        with lock_path.open("a+") as lock_file:
            try:
                fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                busy += 1
                print(f"cargo-lane: scratch slot {slot} busy ({owner_summary(owner_path)})")
            else:
                residue = f"; abandoned target {target_dir}" if target_dir.exists() else ""
                print(f"cargo-lane: scratch slot {slot} free{residue}")
    return busy


def status(lock_path: Path, owner_path: Path, target_dir: Path, state_dir: Path) -> int:
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    shared_busy = False
    with lock_path.open("a+") as lock_file:
        try:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            shared_busy = True
            print(f"cargo-lane: shared lane busy ({owner_summary(owner_path)})")
        else:
            print("cargo-lane: shared lane free (wrapper-managed builds)")
        print(f"cargo-lane: shared target {target_dir}")
    print_sccache_status()
    isolated_status(state_dir)
    return 1 if shared_busy else 0


def command_text(command: list[str]) -> str:
    return " ".join(command)


def validate_disposable(command: list[str]) -> None:
    lowered = [part.lower() for part in command]
    executable = Path(lowered[0]).name
    script_basenames = {Path(part).name for part in lowered}

    if executable in {"tauri", "cargo-tauri"}:
        fail("disposable lanes are not allowed for Tauri release/install workflows")
    if script_basenames.intersection(
        {
            "10-install-matrix.sh",
            "20-sync-contract.sh",
            "30-vault-lifecycle.sh",
            "40-agentic-setup.sh",
        }
    ):
        fail("disposable lanes are not allowed for release-check workflows")
    if executable == "cargo":
        cargo_words = {word for word in lowered[1:] if not word.startswith("-")}
        if cargo_words.intersection({"install", "package", "publish"}):
            fail("disposable lanes are not allowed for cargo install/package/publish")


def validate_isolated(command: list[str]) -> None:
    validate_disposable(command)
    lowered = [part.lower() for part in command]
    executable = Path(lowered[0]).name
    if executable == "cargo":
        if "--release" in lowered:
            fail("isolated mode is reserved for narrow development checks and tests")
        for index, part in enumerate(lowered[:-1]):
            if part == "--profile" and lowered[index + 1] == "release":
                fail("isolated mode is reserved for narrow development checks and tests")


def validate_shared(command: list[str]) -> None:
    lowered = [part.lower() for part in command]
    if Path(lowered[0]).name != "cargo":
        return
    cargo_words = [
        word
        for word in lowered[1:]
        if not word.startswith("-") and not word.startswith("+")
    ]
    action = cargo_words[0] if cargo_words else ""
    if action in {"test", "bench"} or "--example" in lowered or "--examples" in lowered:
        fail(
            "high-churn Cargo tests, benches, and examples belong in the disposable "
            "lane; use scripts/cargo-lane disposable -- <command>"
        )


def run_command(command: list[str], env: dict[str, str]) -> int:
    child: subprocess.Popen[bytes] | None = None

    def forward(signum: int, _frame: object) -> None:
        if child is not None and child.poll() is None:
            child.send_signal(signum)

    previous = {
        signum: signal.signal(signum, forward)
        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
    }
    try:
        child = subprocess.Popen(command, env=env)
        return child.wait()
    except OSError as exc:
        fail(f"could not start {command[0]!r}: {exc}", 127)
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)


def target_size_bytes(target_dir: Path, state_dir: Path) -> int:
    cache_path = state_dir / "shared-target-size.json"
    try:
        cached = json.loads(cache_path.read_text())
        age = time.time() - float(cached["measured_at"])
        if (
            cached.get("target_dir") == str(target_dir)
            and 0 <= age <= TARGET_SIZE_CACHE_MAX_AGE_SECONDS
        ):
            return int(cached["size_bytes"])
    except (KeyError, OSError, TypeError, ValueError):
        pass

    if not target_dir.exists():
        size_bytes = 0
    else:
        try:
            output = subprocess.check_output(
                ["du", "-sk", str(target_dir)],
                text=True,
                stderr=subprocess.STDOUT,
            )
            size_bytes = int(output.split()[0]) * 1024
        except (OSError, subprocess.CalledProcessError, ValueError) as exc:
            fail(f"could not measure shared target before isolated build: {exc}")
    write_json_atomic(
        cache_path,
        {
            "target_dir": str(target_dir),
            "size_bytes": size_bytes,
            "measured_at": time.time(),
        },
    )
    return size_bytes


def require_isolated_capacity(target_dir: Path, state_dir: Path) -> None:
    shared_size = target_size_bytes(target_dir, state_dir)
    required = max(MIN_ISOLATED_FREE_BYTES, shared_size * 2)
    temp_root = Path(tempfile.gettempdir())
    free = shutil.disk_usage(temp_root).free
    gib = 1024**3
    if free < required:
        fail(
            "isolated mode needs "
            f"{required / gib:.1f} GiB free (max of 20 GiB and 2x the shared target); "
            f"{temp_root} has {free / gib:.1f} GiB"
        )
    print(
        f"cargo-lane: isolated capacity {free / gib:.1f} GiB free; "
        f"requires {required / gib:.1f} GiB",
        file=sys.stderr,
        flush=True,
    )


def acquire_isolated_slot(
    state_dir: Path, command: list[str], mode: str
) -> tuple[object, Path, str, int, Path]:
    state_dir.mkdir(parents=True, exist_ok=True)
    announced_wait = False
    while True:
        busy_owners = []
        for slot in range(1, ISOLATED_SLOT_COUNT + 1):
            lock_path, owner_path, target_dir = scratch_slot_paths(state_dir, slot)
            lock_file = lock_path.open("a+")
            try:
                fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                lock_file.close()
                busy_owners.append(owner_summary(owner_path))
                continue
            if remove_scratch_target(state_dir, slot, target_dir):
                print(
                    f"cargo-lane: recovered abandoned scratch target {target_dir}",
                    file=sys.stderr,
                    flush=True,
                )
            target_dir.mkdir(parents=True)
            token = uuid.uuid4().hex
            write_json_atomic(
                owner_path,
                {
                    "token": token,
                    "slot": slot,
                    "mode": mode,
                    "thread_id": os.environ.get("BB_THREAD_ID"),
                    "environment_id": os.environ.get("BB_ENVIRONMENT_ID"),
                    "pid": os.getpid(),
                    "host": socket.gethostname(),
                    "started_at": int(time.time()),
                    "command": command_text(command),
                    "target_dir": str(target_dir),
                },
            )
            return lock_file, owner_path, token, slot, target_dir
        if not announced_wait:
            print(
                "cargo-lane: waiting for an isolated slot "
                f"({ISOLATED_SLOT_COUNT}/{ISOLATED_SLOT_COUNT} busy: "
                + "; ".join(busy_owners)
                + ")",
                file=sys.stderr,
                flush=True,
            )
            announced_wait = True
        time.sleep(1)


def release_isolated_slot(lock_file: object, owner_path: Path, token: str) -> None:
    try:
        recorded = json.loads(owner_path.read_text())
        if recorded.get("token") == token:
            owner_path.unlink(missing_ok=True)
    except (OSError, ValueError):
        pass
    lock_file.close()


def shared(
    command: list[str],
    target_dir: Path,
    lock_path: Path,
    owner_path: Path,
    isolated_state_dir: Path,
) -> int:
    validate_shared(command)
    recover_scratch_slots(isolated_state_dir, announce=False)
    target_dir.mkdir(parents=True, exist_ok=True)
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    token = uuid.uuid4().hex
    owner = {
        "token": token,
        "thread_id": os.environ.get("BB_THREAD_ID"),
        "environment_id": os.environ.get("BB_ENVIRONMENT_ID"),
        "pid": os.getpid(),
        "host": socket.gethostname(),
        "started_at": int(time.time()),
        "command": command_text(command),
        "target_dir": str(target_dir),
    }
    with lock_path.open("a+") as lock_file:
        try:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print(
                f"cargo-lane: waiting for shared lane ({owner_summary(owner_path)})",
                file=sys.stderr,
                flush=True,
            )
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        write_json_atomic(owner_path, owner)
        env = os.environ.copy()
        env["CARGO_TARGET_DIR"] = str(target_dir)
        apply_sccache(env)
        print(f"cargo-lane: shared target {target_dir}", file=sys.stderr, flush=True)
        try:
            return run_command(command, env)
        finally:
            try:
                recorded = json.loads(owner_path.read_text())
                if recorded.get("token") == token:
                    owner_path.unlink(missing_ok=True)
            except (OSError, ValueError):
                pass
            (isolated_state_dir / "shared-target-size.json").unlink(missing_ok=True)


def scratch(command: list[str], target_dir: Path, state_dir: Path, mode: str) -> int:
    if mode == "isolated":
        validate_isolated(command)
    else:
        validate_disposable(command)
    lock_file, owner_path, token, slot, scratch_dir = acquire_isolated_slot(
        state_dir, command, mode
    )
    try:
        require_isolated_capacity(target_dir, state_dir)
        env = os.environ.copy()
        env["CARGO_TARGET_DIR"] = str(scratch_dir)
        env["CARGO_INCREMENTAL"] = "0"
        apply_sccache(env)
        print(
            f"cargo-lane: {mode} scratch slot {slot}/{ISOLATED_SLOT_COUNT}; target {scratch_dir} "
            f"(shared target remains {target_dir})",
            file=sys.stderr,
            flush=True,
        )
        try:
            return run_command(command, env)
        finally:
            try:
                remove_scratch_target(state_dir, slot, scratch_dir)
            except OSError as exc:
                print(
                    f"cargo-lane: warning: cleanup incomplete for {scratch_dir}: {exc}",
                    file=sys.stderr,
                )
            if scratch_dir.exists():
                print(f"cargo-lane: warning: cleanup incomplete for {scratch_dir}", file=sys.stderr)
            else:
                print(f"cargo-lane: removed scratch target {scratch_dir}", file=sys.stderr)
    finally:
        release_isolated_slot(lock_file, owner_path, token)


def prune_scratch(state_dir: Path) -> int:
    recovered = recover_scratch_slots(state_dir, announce=True)
    if recovered == 0:
        print("cargo-lane: no abandoned scratch targets to remove")
    return 0


def main() -> int:
    if len(sys.argv) < 2:
        fail(USAGE.rstrip())
    mode = sys.argv[1]
    target_dir, lock_path, owner_path, isolated_state_dir = paths()
    if mode == "target-dir":
        if len(sys.argv) != 2:
            fail(USAGE.rstrip())
        print(target_dir)
        return 0
    if mode == "cargo-config":
        if len(sys.argv) != 2:
            fail(USAGE.rstrip())
        print(cargo_config_text(target_dir), end="")
        return 0
    if mode == "sccache-stats":
        if len(sys.argv) != 2:
            fail(USAGE.rstrip())
        return sccache_stats()
    if mode == "prune":
        if len(sys.argv) != 2:
            fail(USAGE.rstrip())
        return prune_scratch(isolated_state_dir)
    if mode == "status":
        if len(sys.argv) != 2:
            fail(USAGE.rstrip())
        return status(lock_path, owner_path, target_dir, isolated_state_dir)
    if mode not in {"shared", "isolated", "disposable"} or len(sys.argv) < 4 or sys.argv[2] != "--":
        fail(USAGE.rstrip())
    command = sys.argv[3:]
    if mode == "shared":
        return shared(command, target_dir, lock_path, owner_path, isolated_state_dir)
    return scratch(command, target_dir, isolated_state_dir, mode)


if __name__ == "__main__":
    raise SystemExit(main())
